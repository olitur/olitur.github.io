---
import Button from "./ui/button.astro";
---

<!-- Envoi via formsubmit.co (sans clé) — les messages arrivent sur o.turlier@canopee.org.
     La première soumission depuis le domaine déclenche un email d'activation à confirmer. -->
<form
  action="https://formsubmit.co/ajax/o.turlier@canopee.org"
  method="POST"
  id="form"
  class="needs-validation"
  novalidate>
  <input type="hidden" name="_subject" value="Nouveau message — site Canopée" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
  <div class="mb-5">
    <input
      type="text"
      placeholder="Nom complet"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-stone-500 rounded-md outline-hidden focus:ring-4 border-stone-300 focus:border-[#2D5016] ring-emerald-50"
      name="name"
    />
    <div class="empty-feedback invalid-feedback text-red-500 text-sm mt-1">
      Merci d'indiquer votre nom.
    </div>
  </div>
  <div class="mb-5">
    <label for="email_address" class="sr-only">Adresse email</label><input
      id="email_address"
      type="email"
      placeholder="Adresse email"
      name="email"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-stone-500 rounded-md outline-hidden focus:ring-4 border-stone-300 focus:border-[#2D5016] ring-emerald-50"
    />
    <div class="empty-feedback text-red-500 text-sm mt-1">
      Merci d'indiquer votre adresse email.
    </div>
    <div class="invalid-feedback text-red-500 text-sm mt-1">
      Merci d'indiquer une adresse email valide.
    </div>
  </div>
  <div class="mb-3">
    <textarea
      name="message"
      required
      placeholder="Votre message"
      class="w-full px-4 py-3 border-2 placeholder:text-stone-500 rounded-md outline-hidden h-36 focus:ring-4 border-stone-300 focus:border-[#2D5016] ring-emerald-50"
    ></textarea>
    <div class="empty-feedback invalid-feedback text-red-500 text-sm mt-1">
      Merci d'écrire votre message.
    </div>
  </div>
  <Button type="submit" size="lg" block class="!bg-[#2D5016] hover:!bg-[#3a6a1e] !border-transparent">Envoyer le message</Button>
  <div id="result" class="mt-3 text-center"></div>
</form>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .is-invalid,
  .was-validated :invalid {
    border-color: #dc3545;
  }
</style>

<script is:inline>
  const form = document.getElementById("form");
  const result = document.getElementById("result");

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    form.classList.add("was-validated");
    if (!form.checkValidity()) {
      form.querySelectorAll(":invalid")[0].focus();
      return;
    }
    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    result.innerHTML = "Envoi…";

    fetch("https://formsubmit.co/ajax/o.turlier@canopee.org", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
      body: json,
    })
      .then(async (response) => {
        let json = await response.json();
        if (response.status == 200) {
          result.classList.add("text-green-500");
          result.innerHTML = "Merci, votre message a bien été envoyé.";
        } else {
          console.log(response);
          result.classList.add("text-red-500");
          result.innerHTML = json.message || "Une erreur est survenue. Réessayez.";
        }
      })
      .catch((error) => {
        console.log(error);
        result.innerHTML = "Une erreur est survenue. Réessayez.";
      })
      .then(function () {
        form.reset();
        form.classList.remove("was-validated");
        setTimeout(() => {
          result.style.display = "none";
        }, 5000);
      });
  });
</script>
