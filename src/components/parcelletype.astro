---
import { typesParcelle } from "@/data/types-parcelle";

interface Props {
  cle: string;
  href?: string;
  id?: string;
}

const { cle, href, id } = Astro.props;
const type = typesParcelle[cle];

const Wrapper = href ? "a" : "div";
const wrapperProps = href ? { href } : {};
---

{
  type && (
    <Wrapper
      {...wrapperProps}
      id={id}
      class:list={[
        "block rounded-3xl border border-stone-200 p-6 bg-stone-50 shadow-sm",
        href ? "transition-all duration-300 hover:border-[#2D5016] hover:shadow-md hover:-translate-y-1 scroll-mt-24" : "scroll-mt-24",
      ]}>
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <h3 class="text-lg font-semibold text-stone-800">{type.titre}</h3>
        <span class="px-3 py-1 rounded-full text-sm font-medium bg-[#2D5016] text-white">
          {type.prixM2}
        </span>
      </div>
      <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-stone-600">
        <span>🌱 {type.etat}</span>
        <span>💧 {type.irrigation}</span>
      </div>
      <ul class="mt-4 space-y-2 text-sm text-stone-600">
        {type.texte.map((p) => (
          <li class="flex items-start gap-2">
            <span class="text-emerald-600">✓</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
      {href && (
        <span class="mt-4 inline-block text-sm font-medium text-[#2D5016]">
          Voir la description générique →
        </span>
      )}
    </Wrapper>
  )
}
