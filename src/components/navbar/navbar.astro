---
import Container from "@/components/container.astro";
import { Astronav, MenuItems, MenuIcon, Dropdown, DropdownItems } from "astro-navbar";
import { Image } from "astro:assets";
import logo from "@/assets/logo-canopee.webp";

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const axes = [
  { title: "Résilience alimentaire", path: "/resilience-alimentaire" },
  { title: "Autonomie énergétique", path: "/autonomie-energetique" },
  { title: "Construction bioclimatique", path: "/construction" },
];

type MenuItem = {
  title: string;
  path?: string;
  children?: { title: string; path: string }[];
};

const menuitems: MenuItem[] = [
  { title: "Terrains", path: "/terrains" },
  {
    title: "Ressources",
    children: [
      { title: "Blog", path: "/blog" },
      { title: "Documents", path: "/documents" },
      { title: "Projets", path: "/ressources/projets" },
    ],
  },
  { title: "Formations", path: "/formations" },
  { title: "À propos", path: "/a-propos" },
  { title: "Nous rejoindre", path: "/nous-rejoindre" },
];

const linkClass = overlay
  ? "text-white/90 hover:text-white [text-shadow:0_1px_4px_rgba(0,0,0,0.7)]"
  : "text-stone-600 hover:text-[#2D5016]";
---

<header
  class:list={[
    "w-full z-50",
    overlay ? "absolute top-0 left-0" : "relative",
  ]}>
  <Container>
    <div class="flex flex-col lg:flex-row justify-between items-center py-5">
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between">
          <a href="/" class="inline-flex items-center">
            <Image
              src={logo}
              alt="Canopée"
              class:list={[
                "h-12 w-auto md:h-14",
                overlay && "drop-shadow-[0_2px_5px_rgba(0,0,0,0.45)]",
              ]}
            />
          </a>
          <div class="block lg:hidden">
            <MenuIcon
              class:list={["w-5 h-5", overlay ? "text-white" : "text-stone-700"]}
            />
          </div>
        </div>
        <MenuItems
          class:list={[
            "hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0",
            overlay && "bg-black/40 lg:bg-transparent rounded-lg lg:rounded-none px-4 py-3 lg:p-0 backdrop-blur-sm lg:backdrop-blur-none",
          ]}>
          <ul class="flex flex-col lg:flex-row lg:items-center lg:gap-1">
            <li class="relative">
              <Dropdown class="group">
                <button
                  class:list={[
                    "flex items-center gap-1 lg:px-3 py-2 text-base font-medium transition-colors",
                    linkClass,
                  ]}>
                  <span>Nos actions</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                    class="w-3 h-3 mt-0.5 transition-transform group-open:rotate-180">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                  </svg>
                </button>
                <DropdownItems>
                  <div class="lg:absolute lg:left-0 lg:w-64 z-20 origin-top-left">
                    <div class="lg:mt-2 px-3 lg:py-2 lg:bg-white lg:rounded-lg lg:shadow-lg lg:border lg:border-stone-100 flex flex-col">
                      {
                        axes.map((axe) => (
                          <a
                            href={axe.path}
                            class:list={[
                              "py-2 text-sm transition-colors lg:px-2 lg:rounded-md",
                              overlay
                                ? "text-white/90 hover:text-white lg:text-stone-600 lg:hover:text-[#2D5016] lg:hover:bg-creme"
                                : "text-stone-600 hover:text-[#2D5016] lg:hover:bg-creme",
                            ]}>
                            {axe.title}
                          </a>
                        ))
                      }
                    </div>
                  </div>
                </DropdownItems>
              </Dropdown>
            </li>
            {
              menuitems.map((item) =>
                item.children ? (
                  <li class="relative">
                    <Dropdown class="group">
                      <button
                        class:list={[
                          "flex items-center gap-1 lg:px-3 py-2 text-base font-medium transition-colors",
                          linkClass,
                        ]}>
                        <span>{item.title}</span>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="2.5"
                          stroke="currentColor"
                          class="w-3 h-3 mt-0.5 transition-transform group-open:rotate-180">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                        </svg>
                      </button>
                      <DropdownItems>
                        <div class="lg:absolute lg:left-0 lg:w-56 z-20 origin-top-left">
                          <div class="lg:mt-2 px-3 lg:py-2 lg:bg-white lg:rounded-lg lg:shadow-lg lg:border lg:border-stone-100 flex flex-col">
                            {item.children.map((c) => (
                              <a
                                href={c.path}
                                class:list={[
                                  "py-2 text-sm transition-colors lg:px-2 lg:rounded-md",
                                  overlay
                                    ? "text-white/90 hover:text-white lg:text-stone-600 lg:hover:text-[#2D5016] lg:hover:bg-creme"
                                    : "text-stone-600 hover:text-[#2D5016] lg:hover:bg-creme",
                                ]}>
                                {c.title}
                              </a>
                            ))}
                          </div>
                        </div>
                      </DropdownItems>
                    </Dropdown>
                  </li>
                ) : (
                  <li>
                    <a
                      href={item.path}
                      class:list={[
                        "flex lg:px-3 py-2 items-center text-base font-medium transition-colors",
                        linkClass,
                      ]}>
                      {item.title}
                    </a>
                  </li>
                )
              )
            }
          </ul>
        </MenuItems>
      </Astronav>
    </div>
  </Container>
</header>
