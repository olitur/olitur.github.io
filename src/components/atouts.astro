---
interface Atout {
  icone: string;
  titre: string;
  texte: string;
}

interface Props {
  titre?: string;
  items: Atout[];
}

const { titre = "Atouts du terrain", items } = Astro.props;
---

<div class="not-prose mt-10">
  <h2 class="font-semibold text-stone-700 mb-4">{titre}</h2>
  <div class="grid gap-5 sm:grid-cols-2">
    {
      items.map((a) => (
        <div class="flex gap-3 rounded-3xl border border-stone-200 bg-white p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <span class="text-2xl leading-none" aria-hidden="true">
            {a.icone}
          </span>
          <div>
            <h3 class="font-semibold text-stone-800">{a.titre}</h3>
            <p class="mt-1 text-sm text-stone-600">{a.texte}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
