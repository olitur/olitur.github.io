---
const atouts = [
  {
    icone: "🅿️",
    titre: "Stationnement",
    texte: "Facilités de parking sur place, à proximité immédiate des parcelles.",
  },
  {
    icone: "🌿",
    titre: "Broyat & paillage",
    texte:
      "Dépôt de broyat en accès libre, dont du broyat composté depuis plus de 2 ans — idéal comme paillage et amendement organique.",
  },
  {
    icone: "🏞️",
    titre: "Bord de Durance",
    texte:
      "Les terrains longent la Durance : un cadre naturel pour la détente et les loisirs entre deux séances de jardinage.",
  },
  {
    icone: "🚧",
    titre: "Accès semi-privatif",
    texte:
      "Le projet de voie verte fermera les chemins aux véhicules du public par des barrières ; l'accès restera réservé aux usagers, dont les membres de Canopée — tranquillité et sécurité accrues.",
  },
];
---

<div>
  <h2 class="font-semibold text-stone-700 mb-4">Atouts du site</h2>
  <div class="grid gap-5 sm:grid-cols-2">
    {
      atouts.map((a) => (
        <div class="flex gap-3 rounded-3xl border border-stone-200 bg-white p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <span class="text-2xl leading-none" aria-hidden="true">
            {a.icone}
          </span>
          <div>
            <h3 class="font-semibold text-stone-800">{a.titre}</h3>
            <p class="mt-1 text-sm text-stone-600">{a.texte}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
