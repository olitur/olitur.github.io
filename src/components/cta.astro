---
const valeurs = [
  {
    titre: "Bio & vivrier",
    texte: "Méthodes douces, semences paysannes, zéro intrant chimique — produire pour nourrir sa famille.",
    href: "/a-propos#bio-vivrier",
  },
  {
    titre: "Partage",
    texte: "Outils, eau, compétences et récoltes : tout ce que l'on peut partager, on le partage.",
    href: "/a-propos#partage",
  },
  {
    titre: "Autonomie",
    texte: "Alimentation, énergie, résilience — construire ensemble une indépendance progressive.",
    href: "/a-propos#autonomie",
  },
  {
    titre: "Territoire",
    texte: "Ancré dans le Luberon, en plaine de Durance, attentif aux ressources en eau et aux pratiques locales.",
    href: "/a-propos#territoire",
  },
];
---

<!-- Section valeurs -->
<section class="py-20 border-t border-stone-100">
  <div class="text-center mb-14">
    <span class="text-[#C4881A] font-semibold uppercase tracking-widest text-sm">
      Nos valeurs
    </span>
    <h2 class="mt-3 text-4xl font-bold text-[#2D5016]">Ce qui nous rassemble</h2>
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      valeurs.map((v) => (
        <a
          href={v.href}
          class="group block bg-white border border-stone-200 rounded-3xl p-6 text-center shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <div class="w-12 h-1 bg-[#C4881A] rounded-full mx-auto mb-4" />
          <h3 class="text-lg font-bold text-stone-800 mb-2 group-hover:text-[#2D5016]">{v.titre}</h3>
          <p class="text-stone-600 text-sm leading-relaxed">{v.texte}</p>
          <span class="mt-4 inline-block text-xs font-semibold text-[#2D5016]">
            En savoir plus →
          </span>
        </a>
      ))
    }
  </div>
</section>

<!-- CTA Adhésion -->
<section class="mt-16 bg-white border border-stone-200 rounded-[2rem] px-8 py-16 text-center shadow-sm">
  <span class="text-[#C4881A] font-semibold uppercase tracking-widest text-sm">
    Rejoindre l'association
  </span>
  <h2 class="mt-4 text-4xl font-bold text-[#2D5016]">
    Cultivons ensemble dès cette saison
  </h2>
  <p class="mt-4 text-stone-700 text-lg max-w-xl mx-auto leading-relaxed">
    Adhésion à partir de 25 €/an. Accès aux formations, aux parcelles et à
    la communauté Canopée en Luberon.
  </p>
  <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
    <a
      href="/nous-rejoindre"
      class="inline-block bg-[#C4881A] hover:bg-[#b37716] text-white font-semibold px-8 py-4 rounded-full shadow-sm hover:shadow-md transition-all duration-300">
      Devenir adhérent
    </a>
    <a
      href="/nous-rejoindre#contact"
      class="inline-block border-2 border-[#2D5016]/40 hover:border-[#2D5016] text-[#2D5016] font-semibold px-8 py-4 rounded-full transition-all duration-300">
      Nous contacter
    </a>
  </div>
</section>
