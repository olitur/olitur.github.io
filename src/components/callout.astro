---
// Encart contextuel — transpose les callouts du guide Typst (note / tip / warn / definition)
interface Props {
  type?: "note" | "tip" | "warn" | "definition";
  title?: string;
}
const { type = "note", title } = Astro.props;

const styles = {
  note: {
    wrap: "bg-sky-50 border-sky-400",
    label: "text-sky-700",
    defaut: "À noter",
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />`,
  },
  tip: {
    wrap: "bg-emerald-50 border-emerald-500",
    label: "text-emerald-700",
    defaut: "Conseil",
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />`,
  },
  warn: {
    wrap: "bg-red-50 border-red-400",
    label: "text-red-700",
    defaut: "Attention",
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />`,
  },
  definition: {
    wrap: "bg-amber-50 border-[#C4881A]",
    label: "text-[#9a6a14]",
    defaut: "Définition",
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />`,
  },
};

const s = styles[type];
const heading = title ?? s.defaut;
---

<div class:list={["my-6 rounded-r-lg border-l-4 px-5 py-4", s.wrap]}>
  <div class:list={["flex items-center gap-2 font-semibold text-sm uppercase tracking-wide", s.label]}>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true" set:html={s.icone} />
    {heading}
  </div>
  <div class="mt-2 text-stone-600 leading-relaxed text-[15px]">
    <slot />
  </div>
</div>
