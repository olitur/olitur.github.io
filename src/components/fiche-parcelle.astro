---
interface Props {
  heading?: string;
  titre: string;
  prix: string;
  etat: string;
  irrigation: string;
  points: string[];
  href?: string;
}

const {
  heading = "La parcelle type de ce terrain",
  titre,
  prix,
  etat,
  irrigation,
  points,
  href,
} = Astro.props;

const Wrapper = href ? "a" : "div";
const wrapperProps = href ? { href } : {};
---

<div class="not-prose mt-10">
  <h2 class="font-semibold text-stone-700 mb-3">{heading}</h2>
  <Wrapper
    {...wrapperProps}
    class:list={[
      "block rounded-3xl border border-stone-200 p-6 bg-stone-50 shadow-sm scroll-mt-24",
      href && "transition-all duration-300 hover:border-[#2D5016] hover:shadow-md hover:-translate-y-1",
    ]}>
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <h3 class="text-lg font-semibold text-stone-800">{titre}</h3>
      <span class="px-3 py-1 rounded-full text-sm font-medium bg-[#2D5016] text-white">{prix}</span>
    </div>
    <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-stone-600">
      <span>🌱 {etat}</span>
      <span>💧 {irrigation}</span>
    </div>
    <ul class="mt-4 space-y-2 text-sm text-stone-600">
      {
        points.map((p) => (
          <li class="flex items-start gap-2">
            <span class="text-emerald-600">✓</span>
            <span>{p}</span>
          </li>
        ))
      }
    </ul>
    {
      href && (
        <span class="mt-4 inline-block text-sm font-medium text-[#2D5016]">
          Voir la description générique →
        </span>
      )
    }
  </Wrapper>
</div>
