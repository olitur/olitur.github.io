---
import { Image } from "astro:assets";
import heroImage from "@/assets/hero-luberon.webp";
---

<section class="relative min-h-svh flex items-end overflow-hidden">

  <!-- Image de fond, contenue dans le hero (plus de fond fixe sur toute la page) -->
  <Image
    src={heroImage}
    alt="Jardin maraîcher en Luberon — Association Canopée"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    format="webp"
    class="absolute inset-0 w-full h-full object-cover object-[center_70%]"
  />

  <!-- Dégradé d'overlay : transparent en haut, vert foncé en bas (lisibilité du titre) -->
  <div class="absolute inset-0 bg-gradient-to-t from-[#2D5016]/65 via-transparent to-transparent"></div>

  <!-- Scrim haut : assombrit le ciel sous la barre de menu (lisibilité des liens blancs) -->
  <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/50 to-transparent"></div>

  <!-- Contenu centré -->
  <div class="relative z-10 w-full px-6 pb-16 md:pb-24 max-w-4xl mx-auto">
    <span class="inline-block text-[#C4881A] font-semibold uppercase tracking-widest text-sm mb-4">
      Association Canopée — Luberon, Vaucluse
    </span>
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-tight [text-shadow:0_2px_18px_rgba(0,0,0,0.45)]">
      Vers l'autonomie,<br />ensemble
    </h1>
    <p class="mt-5 text-lg md:text-xl text-white/80 max-w-2xl leading-relaxed [text-shadow:0_1px_10px_rgba(0,0,0,0.4)]">
      Alimentation, énergie, habitat : Canopée cultive la résilience d'un
      territoire — formations, parcelles et chantiers participatifs au cœur du Luberon.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-4">
      <a
        href="/nous-rejoindre"
        class="inline-block bg-[#C4881A] hover:bg-[#b37716] text-white font-semibold px-8 py-4 rounded-lg transition text-center">
        Devenir adhérent
      </a>
      <a
        href="/terrains"
        class="inline-block border-2 border-white/70 hover:border-white text-white font-semibold px-8 py-4 rounded-lg transition text-center backdrop-blur-sm">
        Voir les parcelles
      </a>
    </div>
  </div>

  <!-- Indicateur de défilement -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 animate-bounce opacity-60">
    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>

</section>
