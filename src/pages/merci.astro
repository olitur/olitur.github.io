---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
---

<Layout title="Merci — Canopée">
  <Container>
    <div class="max-w-xl mx-auto text-center mt-24 mb-24">
      <div class="text-6xl mb-6">🌿</div>
      <h1 class="text-4xl font-bold text-[#2D5016] mb-4">Merci pour votre message !</h1>
      <p class="text-lg text-stone-600 leading-relaxed">
        Nous avons bien reçu votre demande et vous recontacterons dans les meilleurs délais,
        généralement sous 2 à 3 jours ouvrés.
      </p>
      <p class="mt-4 text-stone-500">
        En attendant, n'hésitez pas à explorer nos ressources sur le maraîchage
        ou à consulter les formations à venir.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="px-6 py-3 bg-[#2D5016] text-white rounded-lg font-medium hover:bg-[#3a6a1e] transition">
          Retour à l'accueil
        </a>
        <a
          href="/formations"
          class="px-6 py-3 border border-stone-300 text-stone-700 rounded-lg font-medium hover:border-[#2D5016] hover:text-[#2D5016] transition">
          Voir les formations
        </a>
      </div>
    </div>
  </Container>
</Layout>
