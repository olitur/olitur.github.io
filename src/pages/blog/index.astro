---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Breadcrumb from "@/components/breadcrumb.astro";

// Filter blog entries with 'draft: false' & date before current date
const publishedBlogEntries = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// Sort content entries by publication date
publishedBlogEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

// Temps de lecture estimé (~200 mots/min) à partir du corps de l'article
const tempsLecture = (corps?: string) =>
  Math.max(1, Math.round((corps ?? "").trim().split(/\s+/).filter(Boolean).length / 200));

const dateFr = (d: Date) =>
  d.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title="Blog">
  <Container>
    <div class="mt-8">
      <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "Ressources", href: "/ressources" }, { label: "Blog" }]} />
    </div>
    <Sectionhead>
      <Fragment slot="title">Le blog de Canopée</Fragment>
      <Fragment slot="desc">
        Actualités de l'association, retours de terrain et techniques : les articles de Canopée,
        du maraîchage à la vie du projet.
      </Fragment>
    </Sectionhead>
    <main class="mt-14">
      {
        publishedBlogEntries.length === 0 && (
          <p class="text-center text-stone-500 max-w-xl mx-auto">
            Les premiers articles arrivent bientôt. Revenez prochainement pour suivre
            les retours de terrain de Canopée.
          </p>
        )
      }
      <ul class="grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {
          publishedBlogEntries.map((blogPostEntry, index) => (
            <li>
              <a href={`/blog/${blogPostEntry.id}`} class="group block border-t border-stone-300 pt-5">
                <p class="text-sm">
                  <span class="font-semibold text-stone-800">{blogPostEntry.data.author}</span>
                  <span class="text-stone-400"> / </span>
                  <time class="text-stone-400" datetime={blogPostEntry.data.publishDate.toISOString()}>
                    {dateFr(blogPostEntry.data.publishDate)}
                  </time>
                </p>

                <h2 class="mt-3 text-2xl font-bold leading-snug tracking-tight text-stone-800 transition-colors group-hover:text-[#2D5016]">
                  {blogPostEntry.data.title}
                </h2>

                <div class="mt-5 overflow-hidden rounded-2xl">
                  <Picture
                    src={blogPostEntry.data.image.src}
                    alt={blogPostEntry.data.image.alt}
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 460px"
                    width={600}
                    height={375}
                    loading={index <= 5 ? "eager" : "lazy"}
                    decoding={index <= 5 ? "sync" : "async"}
                    class="aspect-[16/10] w-full bg-white object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  />
                </div>

                <p class="mt-5 line-clamp-3 leading-relaxed text-stone-600">
                  {blogPostEntry.data.snippet}
                </p>

                <div class="mt-5 flex items-center justify-between">
                  <span class="inline-flex items-center gap-2 font-semibold text-stone-800 underline decoration-stone-300 underline-offset-4 transition-colors group-hover:decoration-[#2D5016]">
                    Lire
                    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                  <span class="rounded-full bg-stone-100 px-3 py-1 text-xs text-stone-500">
                    {tempsLecture(blogPostEntry.body)} min de lecture
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>
