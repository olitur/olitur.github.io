---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

const formations = await getCollection("formations");
formations.sort((a, b) =>
  new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf()
);

const categorieColors: Record<string, string> = {
  "Maraîchage": "bg-emerald-100 text-emerald-800",
  "Énergie":    "bg-amber-100 text-amber-800",
  "Agriculture": "bg-stone-100 text-stone-700",
};
---

<Layout title="Formations — Canopée">
  <div
    class="w-full py-4 px-4 text-center"
    style="background: repeating-linear-gradient(45deg, #fbbf24, #fbbf24 22px, #1f2937 22px, #1f2937 44px);">
    <span class="inline-block bg-white/95 text-amber-900 font-bold px-5 py-2 rounded shadow">
      🚧 Page en cours d'édition — textes d'exemple à modifier 🚧
    </span>
  </div>
  <Container>
    <Sectionhead>
      <Fragment slot="title">Programme des formations</Fragment>
      <Fragment slot="desc">
        Maraîchage, autonomie alimentaire et énergétique — des ateliers pratiques en Luberon.
      </Fragment>
    </Sectionhead>

    <ul class="mt-12 grid gap-6 max-w-3xl mx-auto">
      {
        formations.map((f) => {
          const dateObj = new Date(f.data.date);
          const dateStr = dateObj.toLocaleDateString("fr-FR", {
            day: "numeric",
            month: "long",
            year: "numeric",
          });
          const colorClass = categorieColors[f.data.categorie] ?? "bg-stone-100 text-stone-700";
          const complet = f.data.placesRestantes === 0;

          return (
            <li>
              <a href={`/formations/${f.id}`} class="block group">
                <div class="bg-white border border-stone-200 rounded-3xl p-6 shadow-sm hover:border-[#2D5016] hover:shadow-md hover:-translate-y-1 transition-all duration-300">
                  <div class="mb-3 inline-flex items-center gap-1 text-xs font-semibold bg-amber-100 text-amber-800 px-2 py-1 rounded">
                    🚧 Texte d'exemple — à modifier
                  </div>
                  <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class={`px-2 py-0.5 rounded text-xs font-medium ${colorClass}`}>
                        {f.data.categorie}
                      </span>
                      <span class="text-xs text-stone-400">{f.data.niveau}</span>
                    </div>
                    {complet && (
                      <span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded">Complet</span>
                    )}
                  </div>
                  <h2 class="mt-2 text-xl font-semibold text-stone-800 group-hover:text-[#2D5016]">
                    {f.data.titre}
                  </h2>
                  <p class="mt-2 text-sm text-stone-500">{f.data.description}</p>
                  <div class="mt-4 flex flex-wrap gap-4 text-sm text-stone-500">
                    <span>📅 {dateStr}</span>
                    <span>⏱ {f.data.duree}</span>
                    <span>👤 {f.data.animateur}</span>
                    {!complet && (
                      <span class="text-emerald-700 font-medium">
                        {f.data.placesRestantes} place{f.data.placesRestantes > 1 ? "s" : ""} restante{f.data.placesRestantes > 1 ? "s" : ""}
                      </span>
                    )}
                  </div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="text-center mt-12">
      <p class="text-stone-500 text-sm">
        Toutes les formations sont gratuites pour les adhérents.
        <a href="/nous-rejoindre" class="underline hover:text-[#2D5016] ml-1">Devenir adhérent →</a>
      </p>
    </div>
  </Container>
</Layout>
